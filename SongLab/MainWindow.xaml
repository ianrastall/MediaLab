<Window x:Class="SongLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SongLab.UI.ViewModels"
        Title="SongLab" Height="820" Width="1100"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Resources/icon-song-lab.png"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="SongLab" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Padding="8,3" CornerRadius="4" Background="{StaticResource ControlBackgroundBrush}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Orange" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tools.AllPresent}" Value="True">
                                            <Setter Property="Fill" Value="LimeGreen" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Tools.StatusText}" Style="{StaticResource SubtleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Button Content="Setup tools..." Padding="10,3" Command="{Binding OpenSetupCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Main content -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: I/O & Tempo -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source" Style="{StaticResource HeaderTextBlockStyle}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Command="{Binding Mastering.TogglePreviewCommand}" Margin="0,0,8,0" Width="40" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="▶" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mastering.IsPreviewPlaying}" Value="True">
                                                <Setter Property="Content" Value="⏸" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <TextBox Grid.Column="1" Text="{Binding Mastering.SourcePath}" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="3" Content="Browse…" Command="{Binding Mastering.PickSourceCommand}" />
                        </Grid>

                        <TextBlock Text="Output" Style="{StaticResource HeaderTextBlockStyle}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Mastering.OutputPath}" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="Save as…" Command="{Binding Mastering.PickOutputCommand}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Delivery format:" Style="{StaticResource SubtleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="160" ItemsSource="{Binding Mastering.DeliveryFormats}" SelectedItem="{Binding Mastering.SelectedFormat}" />
                        </StackPanel>

                        <TextBlock Text="Tempo / stretch (Rubber Band R3)" Style="{StaticResource HeaderTextBlockStyle}" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="50" Maximum="150" Value="{Binding Mastering.TempoPercent}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Mastering.TempoPercent, StringFormat={}{0:0}%}" />
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Run mastering" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding Mastering.RunCommand}" Margin="0,0,10,0"/>
                            <Button Content="Cancel" HorizontalAlignment="Left" Command="{Binding Mastering.CancelCommand}" Padding="10,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Mastering.StatusText}" Style="{StaticResource SubtleTextBlockStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Right: Filters & Loudness -->
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Filters" Style="{StaticResource HeaderTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="160" ItemsSource="{Binding Mastering.Presets}" SelectedItem="{Binding Mastering.SelectedPreset}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="High-pass" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="300" Value="{Binding Mastering.HighPassHz}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Mastering.HighPassHz, StringFormat={}{0:0} Hz}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Low-pass" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="20000" Value="{Binding Mastering.LowPassHz}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Mastering.LowPassHz, StringFormat={}{0:0} Hz}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bass" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding Mastering.BassDb}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Mastering.BassDb, StringFormat={}{0:+0;-0;0} dB}" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Treble" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding Mastering.TrebleDb}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Mastering.TrebleDb, StringFormat={}{0:+0;-0;0} dB}" />
                        </Grid>

                        <TextBlock Text="Loudness (rsgain)" Style="{StaticResource HeaderTextBlockStyle}" />
                        <CheckBox Content="Normalize loudness" IsChecked="{Binding Mastering.ApplyLoudness}" Margin="0,0,0,6" />
                        <Grid IsEnabled="{Binding Mastering.ApplyLoudness}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-24" Maximum="-9" Value="{Binding Mastering.LoudnessTargetLufs}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Mastering.LoudnessTargetLufs, StringFormat={}{0:0.#} LUFS}" />
                        </Grid>
                        <TextBlock Text="YouTube turns down anything hotter than ~-14 LUFS." Style="{StaticResource SubtleTextBlockStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Divider -->
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS" Margin="0,4" />

        <!-- Log -->
        <Border Grid.Row="3" Background="#FF181818" CornerRadius="6" Padding="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Log" Style="{StaticResource HeaderTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copy" Command="{Binding Terminal.CopyCommand}" Padding="8,3" />
                        <Button Content="Clear" Command="{Binding Terminal.ClearCommand}" Padding="8,3" Margin="6,0,0,0" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Terminal.Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource LogTextStyle}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
