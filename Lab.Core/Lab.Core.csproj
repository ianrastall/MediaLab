<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal helpers (e.g. LyricsAligner.Normalize/Similarity) to the test project. -->
    <InternalsVisibleTo Include="MediaLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vosk: Kaldi-based offline speech recognition (second-opinion transcription engine). -->
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Scripts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
