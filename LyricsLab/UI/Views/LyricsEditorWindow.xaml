<Window x:Class="LyricsLab.UI.Views.LyricsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LyricsLab.UI.ViewModels"
        Title="Lyrics Structure Editor" Width="1100" Height="700"
        MinWidth="820" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="*"    />   <!-- main content -->
            <RowDefinition Height="Auto" />   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Lyrics Structure Editor"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding RemainingCount, StringFormat='{}{0} lines remaining'}"
                           Style="{StaticResource SubtleTextBlockStyle}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
            </StackPanel>
            <TextBlock Text="Select lines on the left, then click a section type to claim them."
                       Style="{StaticResource SubtleTextBlockStyle}"
                       VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <!-- ── Main: source | type buttons | sections ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240" />   <!-- source lines -->
                <ColumnDefinition Width="Auto" />                <!-- assignment buttons -->
                <ColumnDefinition Width="1.6*" MinWidth="240" /> <!-- assembled sections -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: source lines ── -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Source lyrics"
                           Style="{StaticResource HeaderTextBlockStyle}" />
                <TextBlock DockPanel.Dock="Top"
                           Text="Shift-click for ranges · Ctrl-click to add individual lines"
                           Style="{StaticResource SubtleTextBlockStyle}"
                           Margin="0,0,0,6" />

                <!-- Add unlisted line (samples, spoken intros, etc.) — Dock="Bottom" must precede fill child -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="Add a line not in the file (e.g. a speech sample):"
                           Style="{StaticResource SubtleTextBlockStyle}"
                           Margin="0,8,0,3" />
                <DockPanel DockPanel.Dock="Bottom">
                    <Button DockPanel.Dock="Right"
                            Content="Add"
                            Command="{Binding AddLineCommand}"
                            Padding="12,5" Margin="6,0,0,0" />
                    <TextBox Text="{Binding NewLineText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddLineCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <ListBox x:Name="SourceListBox"
                         ItemsSource="{Binding RemainingLines}"
                         SelectionMode="Extended"
                         SelectionChanged="SourceListBox_SelectionChanged"
                         PreviewMouseLeftButtonDown="SourceListBox_PreviewMouseLeftButtonDown"
                         MouseMove="SourceListBox_MouseMove"
                         PreviewMouseLeftButtonUp="SourceListBox_PreviewMouseLeftButtonUp"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{StaticResource ControlBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       Padding="4,2" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource ControlBackgroundHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- ── MIDDLE: claim buttons ── -->
            <Border Grid.Column="1"
                    Background="{StaticResource PanelBackgroundBrush}"
                    CornerRadius="6" Padding="10,14"
                    Margin="0,26,10,0">
                <StackPanel>
                    <!-- Vocal section types -->
                    <ItemsControl ItemsSource="{Binding Source={x:Static vm:LyricsEditorViewModel.VocalTypes}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LyricSectionType}">
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.ClaimAsCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Code}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,3"
                                        Padding="8,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,10" />

                    <!-- Instrumental -->
                    <Button Content="Auto-Detect (VAD)"
                            Command="{Binding AutoDetectInstrumentalsCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,3"
                            ToolTip="Run VAD to automatically inject instrumental sections" />
                    <Button Content="+ Instrumental (Manual)"
                            Command="{Binding AddInstrumentalCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,3"
                            ToolTip="Insert an instrumental break at this position manually" />
                </StackPanel>
            </Border>

            <!-- ── RIGHT: assembled sections ── -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Sections  (in song order)"
                           Style="{StaticResource HeaderTextBlockStyle}" />
                <TextBlock DockPanel.Dock="Top"
                           Text="✕ removes a section and returns its lines to the source"
                           Style="{StaticResource SubtleTextBlockStyle}"
                           Margin="0,0,0,6" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EditorSection}">
                                <Border Background="{StaticResource PanelBackgroundBrush}"
                                        CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />   <!-- header row -->
                                            <RowDefinition Height="Auto" />   <!-- preview / duration -->
                                        </Grid.RowDefinitions>

                                        <!-- Section header: summary + controls -->
                                        <DockPanel Grid.Row="0">
                                            <!-- Control buttons pinned right -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Copy" Padding="6,2" Margin="0,0,3,0"
                                                        ToolTip="Duplicate this section"
                                                        Command="{Binding DataContext.DuplicateSectionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="+ Instr" Padding="6,2" Margin="0,0,6,0"
                                                        ToolTip="Insert an instrumental break after this section"
                                                        Command="{Binding DataContext.InsertInstrumentalAfterCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↑" Padding="6,2" Margin="0,0,3,0"
                                                        Command="{Binding DataContext.MoveUpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↓" Padding="6,2" Margin="0,0,3,0"
                                                        Command="{Binding DataContext.MoveDownCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" Padding="6,2"
                                                        Command="{Binding DataContext.RemoveSectionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>

                                            <!-- Section summary (type + line count) -->
                                            <TextBlock Text="{Binding Summary}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <!-- First-line preview (vocal sections only) -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding FirstLinePreview}"
                                                   Style="{StaticResource SubtleTextBlockStyle}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsInstrumental,
                                                       Converter={StaticResource BoolToVisibilityConverter},
                                                       ConverterParameter=invert}" />

                                        <!-- Duration hint (instrumental sections only) -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    Margin="0,4,0,0"
                                                    Visibility="{Binding IsInstrumental,
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Duration hint:"
                                                       Style="{StaticResource SubtleTextBlockStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="55"
                                                     VerticalContentAlignment="Center" />
                                            <TextBlock Text="s  (optional)"
                                                       Style="{StaticResource SubtleTextBlockStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ── Footer ── -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel"
                    IsCancel="True" Padding="16,6" Margin="8,0,0,0"
                    Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="Apply"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Padding="16,6" Margin="8,0,0,0"
                    Click="Apply_Click" />
            <Button DockPanel.Dock="Right" Content="Save As…"
                    Padding="16,6" Margin="8,0,0,0"
                    Click="SaveAs_Click" />
            <Button DockPanel.Dock="Right" Content="Copy XML"
                    Padding="16,6" Margin="8,0,0,0"
                    Click="CopyXml_Click" />
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource SubtleTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />
            <TextBlock Style="{StaticResource SubtleTextBlockStyle}"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasRemainingLines,
                           Converter={StaticResource BoolToVisibilityConverter}}">
                <Run Text="⚠ " /><Run Text="{Binding RemainingCount}" /><Run Text=" line(s) not yet assigned to a section" />
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
