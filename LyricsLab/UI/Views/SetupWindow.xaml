<Window x:Class="LyricsLab.UI.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LyricsLab.UI.ViewModels"
        xmlns:ui="clr-namespace:Lab.UI.Controls;assembly=Lab.UI"
        Title="Whisper / Vosk Setup" Height="620" Width="700"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Speech Engine Setup"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />

        <!-- whisper-cli binary status -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WhisperInstalled}" Value="True">
                                    <Setter Property="Fill" Value="#FF4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding WhisperStatusText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Install whisper-cli…"
                        Command="{Binding InstallWhisperBinaryCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <Button Grid.Column="4" Content="Open folder"
                        Command="{Binding OpenInstallFolderCommand}" />
            </Grid>
        </Border>

        <!-- whisperX venv status -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WhisperxInstalled}" Value="True">
                                    <Setter Property="Fill" Value="#FF4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding WhisperxStatusText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Install whisperX…"
                        Command="{Binding InstallWhisperXCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>

        <!-- FFmpeg status -->
        <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FfmpegInstalled}" Value="True">
                                    <Setter Property="Fill" Value="#FF4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding FfmpegStatusText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Install FFmpeg…"
                        Command="{Binding InstallFfmpegCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>

        <!-- Install-dir note -->
        <TextBlock Grid.Row="4"
                   Text="{Binding InstallDir, StringFormat='Install location: {0}'}"
                   Style="{StaticResource SubtleTextBlockStyle}"
                   Margin="0,0,0,10" />

        <!-- Speech Models status -->
        <Border Grid.Row="5" Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpeechModelsInstalled}" Value="True">
                                    <Setter Property="Fill" Value="#FF4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding SpeechModelsStatusText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Install Speech Models…"
                        Command="{Binding InstallSpeechModelsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>

        <!-- Progress bar -->
        <Grid Grid.Row="6" Margin="0,0,0,6"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Height="16"
                         Value="{Binding ProgressValue}" Minimum="0" Maximum="1" />
            <Button Grid.Column="2" Content="Cancel"
                    Command="{Binding CancelDownloadCommand}" />
        </Grid>

        <!-- Progress text -->
        <TextBlock Grid.Row="7"
                   Text="{Binding ProgressText}"
                   Style="{StaticResource SubtleTextBlockStyle}"
                   Margin="0,0,0,6"
                   Visibility="{Binding ProgressText,
                       Converter={StaticResource NullOrEmptyToVisibilityConverter},
                       ConverterParameter=invert}" />

        <!-- Log -->
        <Border Grid.Row="8" Background="#FF181818" CornerRadius="4" Padding="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxHeight="100"
                Visibility="{Binding LogText,
                    Converter={StaticResource NullOrEmptyToVisibilityConverter},
                    ConverterParameter=invert}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:AutoScrollBehavior.AutoScroll="True">
                <TextBlock Text="{Binding LogText}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           Foreground="{StaticResource SubtleForegroundBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
